<?php

namespace Tests\Feature;

use App\Models\Categoria;
use App\Models\Estado;
use App\Models\EstadoEvento;
use App\Models\HistorialEstadoEvento;
use App\Models\HistorialEstadoNoticia;
use App\Models\Medio;
use App\Models\Noticia;
use App\Models\User;
use App\Models\Evento;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Http\UploadedFile;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Storage;
use Tests\TestCase;

class HistorialEstadosShowTest extends TestCase
{
    use RefreshDatabase;

    private function crearNoticia(): Noticia
    {
        Storage::fake('public');
        $usuario = User::factory()->create();
        $categoria = Categoria::create(['nombre' => 'Test', 'slug' => 'test', 'activa' => true]);
        $estado = Estado::firstOrCreate(['codigo' => 'publicada'], ['nombre' => 'Publicada']);

        return Noticia::create([
            'titulo' => 'Noticia de prueba',
            'slug' => 'noticia-de-prueba',
            'contenido' => 'Contenido',
            'categoria_id' => $categoria->id,
            'autor_id' => $usuario->id,
            'estado_id' => $estado->id,
            'fecha_publicacion' => now(),
        ]);
    }

    private function crearEvento(): Evento
    {
        $usuario = User::factory()->create();
        $categoria = Categoria::create(['nombre' => 'Eventos', 'slug' => 'eventos', 'activa' => true]);
        $estado = EstadoEvento::firstOrCreate(['codigo' => 'programado'], ['nombre' => 'Programado']);

        return Evento::create([
            'titulo' => 'Evento de prueba',
            'slug' => 'evento-de-prueba',
            'descripcion' => 'DescripciÃ³n',
            'fecha_inicio' => now()->addDay(),
            'lugar' => 'Aula',
            'categoria_id' => $categoria->id,
            'organizador_id' => $usuario->id,
            'estado_evento_id' => $estado->id,
            'destacada' => false,
        ]);
    }

    public function test_la_vista_de_noticia_muestra_historial_cuando_existe_sin_n1(): void
    {
        $usuario = User::factory()->create();
        $estado1 = Estado::firstOrCreate(['codigo' => 'borrador'], ['nombre' => 'Borrador']);
        $estado2 = Estado::firstOrCreate(['codigo' => 'publicada'], ['nombre' => 'Publicada']);

        $noticia = $this->crearNoticia();
        $noticia->update(['estado_id' => $estado2->id]);

        HistorialEstadoNoticia::create([
            'noticia_id' => $noticia->id,
            'estado_anterior_id' => $estado1->id,
            'estado_nuevo_id' => $estado2->id,
            'usuario_id' => $usuario->id,
            'cambiado_en' => now(),
        ]);

        DB::enableQueryLog();
        $response = $this->get(route('noticias.show', $noticia));
        $queries = DB::getQueryLog();
        DB::disableQueryLog();

        $response->assertStatus(200);
        $response->assertSee('Borrador');
        $response->assertSee('Publicada');
        $response->assertSee($usuario->name);
        $response->assertSee($usuario->email);

        $this->assertLessThanOrEqual(20, count($queries));
    }

    public function test_la_vista_de_evento_muestra_historial_cuando_existe_sin_n1(): void
    {
        $usuario = User::factory()->create();
        $estado1 = EstadoEvento::firstOrCreate(['codigo' => 'borrador'], ['nombre' => 'Borrador']);
        $estado2 = EstadoEvento::firstOrCreate(['codigo' => 'programado'], ['nombre' => 'Programado']);

        $evento = $this->crearEvento();
        $evento->update(['estado_evento_id' => $estado2->id]);

        HistorialEstadoEvento::create([
            'evento_id' => $evento->id,
            'estado_anterior_id' => $estado1->id,
            'estado_nuevo_id' => $estado2->id,
            'usuario_id' => $usuario->id,
            'cambiado_en' => now(),
        ]);

        DB::enableQueryLog();
        $response = $this->get(route('eventos.show', $evento));
        $queries = DB::getQueryLog();
        DB::disableQueryLog();

        $response->assertStatus(200);
        $response->assertSee('Borrador');
        $response->assertSee('Programado');
        $response->assertSee($usuario->name);
        $response->assertSee($usuario->email);

        $this->assertLessThanOrEqual(20, count($queries));
    }

    public function test_no_aparece_tabla_de_historial_si_no_hay_registros(): void
    {
        $noticia = $this->crearNoticia();
        $evento = $this->crearEvento();

        $this->get(route('noticias.show', $noticia))->assertStatus(200)->assertDontSee('Historial');
        $this->get(route('eventos.show', $evento))->assertStatus(200)->assertDontSee('Historial');
    }
}
